# Bot — required to run digitex-bot
BOT_TOKEN=            # from @BotFather
BOT_ADMIN_USER_ID=    # your Telegram user id

# Database — POSTGRES_PASSWORD is required by docker-compose
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://digitex:<password>@127.0.0.1:5433/digitex
DB_SSLMODE=disable

# Logging
LOGGING_CONSOLE_LEVEL=INFO
LOGGING_FILE_LEVEL=DEBUG

# Local workflows only — not needed on the VPS
LABEL_STUDIO_API_KEY=
LABEL_STUDIO_LOCAL_FILES_SERVING_ENABLED=true
LABEL_STUDIO_LOCAL_FILES_DOCUMENT_ROOT=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
